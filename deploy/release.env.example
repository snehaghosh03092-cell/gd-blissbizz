# Generate a private deploy/release.env with scripts/release-init.py ON THE VPS.
RELEASE_TAG=20261120-platform-01
MYSQL_PASSWORD=replace-with-generated-hex
MYSQL_ROOT_PASSWORD=replace-with-different-generated-hex
INTERNAL_SIGNING_SECRET=replace-with-generated-hex
# Use the existing live /tls bind-mount source directory. Certificates stay on the VPS.
TLS_DIR=/absolute/existing/certificate/directory
BIND_ADDRESS=127.0.0.1
HTTP_PORT=18080
HTTPS_PORT=18443
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
GUIDE_MODEL=claude-sonnet-5-5
SWEEP_INTERVAL_SECONDS=0
