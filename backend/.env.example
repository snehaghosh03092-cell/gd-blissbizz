DATABASE_URL=mysql+pymysql://blissbiz:REDACTED-EXAMPLE-CREDENTIAL@127.0.0.1:3307/blissbiz?charset=utf8mb4
APP_ENV=development
ANONYMOUS_SESSION_TTL_SECONDS=900
OWNER_SESSION_TTL_SECONDS=28800
STOREFRONT_BASE_URL=http://localhost:5173
ADMIN_BASE_URL=http://admin.localhost:5173
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=900
# Exact admin UI/API origins only. JSON array; no wildcard or public storefront origins.
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://admin.localhost:5173","http://127.0.0.1:8000","http://localhost:8000","http://admin.localhost:8000"]

# --- Planned configuration (documented in docs/09-integrations-and-local-run.md; not read by the code yet) ---
# PAYMENT_PROVIDER=fake                 # fake only for now (no real provider decided)
# FAKE_PAYMENT_WEBHOOK_SECRET=change-me # local signing secret for the fake provider
# EMAIL_PROVIDER=console                # console | godaddy_smtp
# GODADDY_SMTP_HOST=smtpout.secureserver.net
# GODADDY_SMTP_PORT=587
# GODADDY_SMTP_USER=
# GODADDY_SMTP_PASSWORD=
# GODADDY_SMTP_FROM=
# EMAIL_DAILY_LIMIT=200
# SMS_PROVIDER=console                  # no GoDaddy SMS API found; provider undecided
# ANTHROPIC_API_KEY=
# INTERNAL_SIGNING_SECRET=change-me     # service-to-service request signing
# Service addresses (defaults shown; scripts/dev_all.sh sets them)
# IDENTITY_URL=http://127.0.0.1:8101
# STORE_URL=http://127.0.0.1:8102
# CATALOG_URL=http://127.0.0.1:8103
# Agent also uses CATALOG_URL for explicitly confirmed recommendation discounts.
# SUPPLY_URL=http://127.0.0.1:8104
# SALES_URL=http://127.0.0.1:8105
# BILLING_URL=http://127.0.0.1:8106
# AGENT_URL=http://127.0.0.1:8107
# ANTHROPIC_API_KEY=                        # optional: assistant inference (browser voice needs no key)
# CHAT_MODEL=claude-haiku-5-5         # agent: tool selection and grounded shopper responses
# GUIDE_MODEL=claude-sonnet-5-5      # agent: Business Guide conversations
# Voice input uses the browser Web Speech API; no speech API key or model is required.
# GATEWAY_PORT=8000                     # dev_all.sh only
# SWEEP_INTERVAL_SECONDS=300            # sales: release expired stock holds every 5 min (0 = off)
# COD_RESERVATION_SECONDS=604800        # sales: unpacked cash-on-delivery orders auto-cancel after 7 days
# PACKED_HOLD_SECONDS=1209600           # sales: packed orders' holds are extended, never cancelled
# UPLOAD_DIR=var/uploads                # supply: original supplier bills (kept outside git)

# Frontend production build only (not read by Python):
# VITE_BASE_DOMAIN=blissbiz.biz  # default localhost; see deploy/README.md
